rules_version = '2';

// ============================================================
// OT Monitoring — Firestore security rules
// ------------------------------------------------------------
// Paste this whole file into: Firebase Console → Firestore → Rules → Publish.
// Keep it in sync with the per-user access model in script.js
// (ACCESS_AREAS / effectiveAccess / hasAccess).
//
// Access model
//   role   : 'owner' (Super Admin) | 'staff' | 'pbt' | 'khl'  (on /users/{uid})
//            'team' and 'viewer' are legacy roles, still honoured unchanged.
//   access : per-area override map, e.g.
//            { editUnits:'edit', implements:'view', damage:'edit',
//              licenseStock:'none', teamShift:'view', teamLog:'edit',
//              teamMembers:'none', teamLogApprove:'edit', warehouse:'edit',
//              history:'view', csv:'export' }
//   Missing override → role default. Only 'owner' (everything) and the legacy
//   'team' (edit) carry defaults; staff/pbt/khl/viewer grant nothing on their
//   own, so every area is granted explicitly in the app's Akses dialog.
//   Owner is always a superuser and can never be locked out.
//
//   activeSession : { id, startedAt, device } — the one device currently
//   signed in. A user may write this one field on their own document; the
//   newest sign-in wins and every other device signs itself out.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Identity helpers ----
    function isSignedIn() { return request.auth != null; }
    function myDoc()      { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isActive()   { return isSignedIn() && myDoc().data.status == 'active'; }
    function isOwner()    { return isActive() && myDoc().data.role == 'owner'; }

    // Effective access level for an area: explicit override → role default.
    function lvl(area) {
      return isOwner()
        ? 'edit'
        : (myDoc().data.access != null && myDoc().data.access[area] != null)
            ? myDoc().data.access[area]
            : (myDoc().data.role == 'team' ? 'edit' : 'none');
    }
    function canEditArea(area) { return isActive() && lvl(area) == 'edit'; }

    // True if the user may edit ANY data area — used to gate audit-log writes,
    // since every edit action also appends a history event.
    function canEditAnything() {
      return isActive() && (
        lvl('editUnits')    == 'edit' ||
        lvl('implements')   == 'edit' ||
        lvl('damage')       == 'edit' ||
        lvl('licenseStock') == 'edit' ||
        lvl('teamShift')    == 'edit' ||
        lvl('teamLog')      == 'edit' ||
        lvl('teamMembers')  == 'edit' ||
        lvl('teamLogApprove') == 'edit' ||
        lvl('warehouse')    == 'edit'
      );
    }

    // ---- Fleet data (one area each) ----
    match /units/{id}         { allow read: if isActive(); allow write: if canEditArea('editUnits'); }
    match /implements/{id}    { allow read: if isActive(); allow write: if canEditArea('implements'); }
    match /damageRecords/{id} { allow read: if isActive(); allow write: if canEditArea('damage'); }
    match /licenseStock/{id}  { allow read: if isActive(); allow write: if canEditArea('licenseStock'); }

    // ---- Managed dropdown sources ----
    // User categories are edited from the unit form; damage components from
    // the damage form — so each follows its own area.
    match /userCategories/{catId} { allow read: if isActive(); allow write: if canEditArea('editUnits'); }
    match /damageComponents/{id}  { allow read: if isActive(); allow write: if canEditArea('damage'); }

    // ---- Team operations (one area each) ----
    // Split three ways on purpose: someone may read the schedule without
    // setting it, and file their daily report without touching the roster.
    // Reads stay open to any active user so people can see who is on duty.
    //
    // Work logs are deliberately NOT restricted to their own author: an office
    // admin files reports on behalf of field operators who have no login. Every
    // write is still attributed in /history, so who filed what stays traceable.
    match /teamMembers/{id} { allow read: if isActive(); allow write: if canEditArea('teamMembers'); }
    match /shifts/{id}      { allow read: if isActive(); allow write: if canEditArea('teamShift'); }

    // Work logs are written by whoever may edit them, and approved by whoever
    // holds 'teamLogApprove' — a separate grant, so a checker need not be able
    // to rewrite the report they are checking. affectedKeys().hasOnly() is what
    // enforces that: an approver's write may touch the approval fields and
    // nothing else, so they cannot quietly change the hours or the description
    // on their way past. Creating and deleting stay with the editors.
    match /workLogs/{id} {
      allow read:   if isActive();
      allow create: if canEditArea('teamLog');
      allow delete: if canEditArea('teamLog');
      allow update: if canEditArea('teamLog')
                    || (canEditArea('teamLogApprove')
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['approval', 'approvedBy', 'approvedByEmail',
                                       'approvedAt', 'revisionNote',
                                       'reviewedBy', 'reviewedAt', 'updatedAt']));
    }

    // Field documentation photos, one document per report. Split out of the
    // work log itself because workLogs is subscribed whole, with no limit —
    // inline photos meant every device re-downloaded every photo on every app
    // open. Same area as the report: whoever may edit a report may edit its
    // photos, so there is no new permission to hand out per person.
    match /workLogPhotos/{id} {
      allow read:  if isActive();
      allow write: if canEditArea('teamLog');
    }

    // Damage photos, one document per record. Split out for the same reason as
    // workLogPhotos: damageRecords is subscribed whole, with no limit, so an
    // inline photo was re-downloaded by every device on every app open — and it
    // rode along into localStorage, where a few dozen of them filled the origin
    // quota and silently stopped unit saves and the automatic backup. Same area
    // as the record: whoever may edit a damage record may edit its photo, so
    // there is no new permission to hand out per person.
    match /damagePhotos/{id} {
      allow read:  if isActive();
      allow write: if canEditArea('damage');
    }

    // ---- Warehouse ----
    // One area covers both shapes: devices followed by serial number, and
    // consumables counted by quantity. Reads stay open to any active user so
    // anyone can check what is in stock before driving to the warehouse.
    match /devices/{id}    { allow read: if isActive(); allow write: if canEditArea('warehouse'); }
    match /stockItems/{id} { allow read: if isActive(); allow write: if canEditArea('warehouse'); }

    // ---- Accounts ----
    // Sign-up may only ever create a PENDING VIEWER. Without this, any signed-in
    // user could write {role:'owner', status:'active'} to their own document and
    // take over the whole project. Role/access changes are owner-only.
    // The allowlist below must stay in sync with OWNER_EMAILS in firebase-init.js.
    function isOwnerEmail() {
      return isSignedIn()
             && request.auth.token.email != null
             && request.auth.token.email.lower() in ['mhmmdfiqriarrasyid@gmail.com'];
    }
    function selfBootstrapsAsOwner() {
      return isOwnerEmail()
             && request.resource.data.role == 'owner'
             && request.resource.data.status == 'active';
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isOwner());

      // Own document only, and only as a pending viewer with no access map —
      // except the allowlisted owner, which bootstraps itself.
      allow create: if isSignedIn() && request.auth.uid == uid && (
                      (request.resource.data.role == 'viewer'
                       && request.resource.data.status == 'pending'
                       && !('access' in request.resource.data))
                      || selfBootstrapsAsOwner()
                    );

      // Owners manage everyone. The allowlisted owner may also repair its own
      // document (otherwise a demoted owner can never recover — isOwner() is
      // already false at that point).
      //
      // The third clause is what makes one-session-per-account possible: a
      // signed-in user may claim the session slot on their OWN document, and
      // affectedKeys().hasOnly() pins that to the single 'activeSession' field.
      // Role, status and access stay owner-only, so this opens no path to
      // self-promotion.
      allow update: if isOwner()
                    || (request.auth.uid == uid && selfBootstrapsAsOwner())
                    || (request.auth.uid == uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['activeSession']));

      allow delete: if isOwner();
    }

    // ---- Audit log ----
    // Append-only: events can be created by any editor but never edited, and
    // the actor must be the signed-in user. Only owners may clear history.
    match /history/{eventId} {
      allow read:   if isActive();
      allow create: if canEditAnything()
                    && request.resource.data.actorUid == request.auth.uid;
      allow update: if false;
      allow delete: if isOwner();
    }
  }
}
