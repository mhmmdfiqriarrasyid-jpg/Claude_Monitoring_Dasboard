rules_version = '2';

// ============================================================
// OT Monitoring — Firestore security rules
// ------------------------------------------------------------
// Paste this whole file into: Firebase Console → Firestore → Rules → Publish.
// Keep it in sync with the per-user access model in script.js
// (ACCESS_AREAS / effectiveAccess / hasAccess).
//
// Access model
//   role   : 'owner' (Super Admin) | 'staff' | 'pbt' | 'khl'  (on /users/{uid})
//            'team' and 'viewer' are legacy roles, still honoured unchanged.
//   access : per-area override map, e.g.
//            { editUnits:'edit', implements:'view', damage:'edit',
//              licenseStock:'none', teamShift:'view', teamLog:'edit',
//              teamMembers:'none', teamLogApprove:'edit', warehouse:'edit',
//              inspection:'edit', inspectionApprove:'edit',
//              history:'view', csv:'export' }
//   Missing override → role default. Only 'owner' (everything) and the legacy
//   'team' (edit) carry defaults; staff/pbt/khl/viewer grant nothing on their
//   own, so every area is granted explicitly in the app's Akses dialog.
//   Owner is always a superuser and can never be locked out.
//
//   activeSession : { id, startedAt, device } — the one device currently
//   signed in. A user may write this one field on their own document; the
//   newest sign-in wins and every other device signs itself out.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Identity helpers ----
    function isSignedIn() { return request.auth != null; }
    function myDoc()      { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isActive()   { return isSignedIn() && myDoc().data.status == 'active'; }
    function isOwner()    { return isActive() && myDoc().data.role == 'owner'; }

    // Effective access level for an area: explicit override → role default.
    // .get() with defaults: reading a key the access map does not have is an
    // evaluation ERROR in rules, not null — it happened to deny, but only by
    // accident, and an error inside && / || is easy to get wrong.
    function lvl(area) {
      return isOwner()
        ? 'edit'
        : myDoc().data.get('access', {}).get(area, null) != null
            ? myDoc().data.get('access', {}).get(area, null)
            : (myDoc().data.get('role', '') == 'team' ? 'edit' : 'none');
    }
    function canEditArea(area) { return isActive() && lvl(area) == 'edit'; }
    function canViewArea(area) { return isActive() && lvl(area) in ['view', 'edit']; }

    // The stored "id" field, when present, must be the document id: the app
    // builds edit/delete targets from it.
    function idMatches(id) {
      return !('id' in request.resource.data) || request.resource.data.id == id;
    }

    // True if the user may edit ANY data area — used to gate audit-log writes,
    // since every edit action also appends a history event.
    function canEditAnything() {
      return isActive() && (
        lvl('editUnits')    == 'edit' ||
        lvl('implements')   == 'edit' ||
        lvl('damage')       == 'edit' ||
        lvl('licenseStock') == 'edit' ||
        lvl('teamShift')    == 'edit' ||
        lvl('teamLog')      == 'edit' ||
        lvl('teamMembers')  == 'edit' ||
        lvl('teamLogApprove') == 'edit' ||
        lvl('warehouse')    == 'edit' ||
        lvl('inspection')   == 'edit' ||
        lvl('inspectionApprove') == 'edit'
      );
    }

    // ---- Fleet data (one area each) ----
    match /units/{id}         { allow read: if isActive(); allow delete: if canEditArea('editUnits');
                                allow create, update: if canEditArea('editUnits') && idMatches(id); }
    match /implements/{id}    { allow read: if isActive(); allow delete: if canEditArea('implements');
                                allow create, update: if canEditArea('implements') && idMatches(id); }
    match /damageRecords/{id} { allow read: if isActive(); allow delete: if canEditArea('damage');
                                allow create, update: if canEditArea('damage') && idMatches(id); }
    match /licenseStock/{id}  { allow read: if isActive(); allow delete: if canEditArea('licenseStock');
                                allow create, update: if canEditArea('licenseStock') && idMatches(id); }

    // ---- Managed dropdown sources ----
    // User categories are edited from the unit form; damage components from
    // the damage form — so each follows its own area.
    match /userCategories/{catId} { allow read: if isActive(); allow write: if canEditArea('editUnits'); }
    match /damageComponents/{id}  { allow read: if isActive(); allow write: if canEditArea('damage'); }

    // ---- Master lists: Site, Brand (implements), Company (team) ----
    // One document per list. Sites belong to the unit editors, brands to
    // whoever edits implements or units, companies to the team-member editors.
    function canEditMasterList(kind) {
      return (kind == 'site' && canEditArea('editUnits'))
          || (kind == 'brand' && (canEditArea('implements') || canEditArea('editUnits')))
          || (kind == 'company' && canEditArea('teamMembers'));
    }
    match /masterLists/{kind} {
      allow read: if isActive();
      allow delete: if canEditMasterList(kind);
      allow create, update: if canEditMasterList(kind)
        && request.resource.data.id == kind
        && request.resource.data.values is list
        && request.resource.data.values.size() <= 500;
    }

    // ---- Team operations (one area each) ----
    // Split three ways on purpose: someone may read the schedule without
    // setting it, and file their daily report without touching the roster.
    // Reads stay open to any active user so people can see who is on duty.
    //
    // Work logs are deliberately NOT restricted to their own author: an office
    // admin files reports on behalf of field operators who have no login. Every
    // write is still attributed in /history, so who filed what stays traceable.
    match /teamMembers/{id} { allow read: if isActive(); allow delete: if canEditArea('teamMembers');
                              allow create, update: if canEditArea('teamMembers') && idMatches(id); }
    match /shifts/{id}      { allow read: if isActive(); allow delete: if canEditArea('teamShift');
                              allow create, update: if canEditArea('teamShift') && idMatches(id)
                                && request.resource.data.get('shift', '') in ['pagi', 'siang', 'malam', 'libur', '']; }

    // ---- Approval (work logs and leave requests) ----
    // Enforced HERE, not only in the app: from the browser console anyone
    // with teamLog edit could otherwise write approval:'approved' under a
    // supervisor's name, and an approver could approve their own report.
    //
    // The flow:  draft ──Kirim──▶ pending ──Setujui──▶ approved
    //              ▲                │  │                  │
    //              └─Tarik kembali──┘  └──Minta revisi──▶ revision ◀──┘
    //            draft / revision are open to editors; pending and
    //            approved are locked until the checker acts.
    // Records written before approval existed have no field: pending.
    function apprOf(d)     { return d.get('approval', 'pending'); }
    function isOpen(d)     { return apprOf(d) in ['draft', 'revision']; }
    function approvalKeys() {
      return ['approval', 'approvedBy', 'approvedByEmail', 'approvedAt',
              'revisionNote', 'reviewedBy', 'reviewedAt', 'updatedAt'];
    }
    // An editor changes an OPEN record, and leaves it a draft or sends it —
    // never approved, never under someone's signature, and never as someone
    // else's: the author cannot be rewritten.
    function editorWrite() {
      return isOpen(resource.data)
          && apprOf(request.resource.data) in ['draft', 'pending']
          && request.resource.data.get('approvedByEmail', '') == ''
          && request.resource.data.get('createdByUid', '') == resource.data.get('createdByUid', '');
    }
    // Tarik kembali: the sender pulls a pending record back to a draft before
    // anyone has checked it, and changes nothing else on the way.
    function withdrawWrite() {
      return apprOf(resource.data) == 'pending'
          && request.resource.data.get('approval', '') == 'draft'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approval', 'updatedAt'])
          && resource.data.get('createdByUid', '') in ['', request.auth.uid];
    }
    // An approver touches the approval fields only, never checks their own
    // record, approves only what was sent, signs with their own e-mail, and
    // sends back — with a reason — only what was sent or already approved.
    function approverWrite() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(approvalKeys())
          && resource.data.get('createdByUid', '') != request.auth.uid
          && ((request.resource.data.get('approval', '') == 'approved'
                && apprOf(resource.data) == 'pending'
                && request.resource.data.get('approvedByEmail', '') == request.auth.token.email)
              || (request.resource.data.get('approval', '') == 'revision'
                && apprOf(resource.data) in ['pending', 'approved']
                && request.resource.data.get('revisionNote', '') is string
                && request.resource.data.get('revisionNote', '').size() > 0));
    }
    function newRecord(id) {
      return idMatches(id)
          && apprOf(request.resource.data) in ['draft', 'pending']
          && request.resource.data.get('approvedByEmail', '') == ''
          && request.resource.data.get('createdByUid', request.auth.uid) == request.auth.uid;
    }
    function teamLogReader() {
      return canViewArea('teamLog') || canViewArea('teamLogApprove') || canViewArea('leader');
    }

    // Work logs are written by whoever may edit them, and approved by whoever
    // holds 'teamLogApprove' — a separate grant, so a checker need not be able
    // to rewrite the report they are checking. affectedKeys().hasOnly() is what
    // enforces that: an approver's write may touch the approval fields and
    // nothing else, so they cannot quietly change the hours or the description
    // on their way past. Deleting follows editing: only an open record.
    match /workLogs/{id} {
      allow read:   if teamLogReader();
      allow create: if isOwner() || (canEditArea('teamLog') && newRecord(id));
      allow delete: if isOwner() || (canEditArea('teamLog') && isOpen(resource.data));
      allow update: if isOwner()
                    || (idMatches(id) && canEditArea('teamLog') && (editorWrite() || withdrawWrite()))
                    || (canEditArea('teamLogApprove') && approverWrite());
    }

    // Izin / sakit. Areanya sama dengan laporan harian: orang yang mencatat
    // laporan tim adalah orang yang mencatat izinnya, dan atasan yang
    // menyetujui laporan adalah atasan yang menyetujui izin. Tidak ada izin
    // baru yang perlu diatur per orang.
    //
    // Klausa hasOnly-nya menahan hal yang sama seperti di workLogs: tanpa itu,
    // siapa pun yang boleh menyetujui juga bisa diam-diam mengubah tanggal dan
    // alasannya, lalu menyetujui versi yang sudah ia ubah sendiri.
    //
    // Surat sakit / surat izin TIDAK punya koleksi sendiri — ia menumpang
    // workLogPhotos di bawah ini. Bentuknya sama persis dan areanya sama
    // persis, jadi memberinya koleksi sendiri hanya akan menambah satu lagi
    // jalur yang menunggu publish, dengan kegagalan yang tidak bisa dibedakan.
    // Leave reasons are personal; the shift grid shows approved leave, so
    // whoever can see the schedule may read them too.
    match /leaveRequests/{id} {
      allow read:   if teamLogReader() || canViewArea('teamShift');
      allow create: if isOwner() || (canEditArea('teamLog') && newRecord(id));
      allow delete: if isOwner() || (canEditArea('teamLog') && isOpen(resource.data));
      allow update: if isOwner()
                    || (idMatches(id) && canEditArea('teamLog') && (editorWrite() || withdrawWrite()))
                    || (canEditArea('teamLogApprove') && approverWrite());
    }

    // Photos and letters follow their record: they change only while it is
    // open, so a sent or approved report cannot have its evidence swapped
    // underneath it. No record yet means one being created — the app writes
    // the photos first, then the record.
    function recordOpen(id) {
      return exists(/databases/$(database)/documents/workLogs/$(id))
          ? isOpen(get(/databases/$(database)/documents/workLogs/$(id)).data)
          : (exists(/databases/$(database)/documents/leaveRequests/$(id))
              ? isOpen(get(/databases/$(database)/documents/leaveRequests/$(id)).data)
              : true);
    }

    // Field documentation photos, one document per report. Split out of the
    // work log itself because workLogs is subscribed whole, with no limit —
    // inline photos meant every device re-downloaded every photo on every app
    // open. Same area as the report: whoever may edit a report may edit its
    // photos, so there is no new permission to hand out per person.
    // Holds sick-leave letters — medical data. Only people who work with
    // reports and leave may read it.
    match /workLogPhotos/{id} {
      allow read:  if canViewArea('teamLog') || canViewArea('teamLogApprove');
      allow write: if isOwner() || (canEditArea('teamLog') && recordOpen(id));
    }

    // Damage photos, one document per record. Split out for the same reason as
    // workLogPhotos: damageRecords is subscribed whole, with no limit, so an
    // inline photo was re-downloaded by every device on every app open — and it
    // rode along into localStorage, where a few dozen of them filled the origin
    // quota and silently stopped unit saves and the automatic backup. Same area
    // as the record: whoever may edit a damage record may edit its photo, so
    // there is no new permission to hand out per person.
    match /damagePhotos/{id} {
      allow read:  if canViewArea('damage');
      allow write: if canEditArea('damage');
    }

    // ---- Heavy-equipment checks ----
    // Same draft → sent → approved / sent-back flow as the daily report, with
    // its own two grants: 'inspection' for the technician who checks and
    // files, 'inspectionApprove' for the supervisor who signs off. The
    // approval functions above are reused unchanged.
    function inspectionReader() {
      return canViewArea('inspection') || canViewArea('inspectionApprove') || canViewArea('leader');
    }
    // The schedule is set by whoever checks or approves.
    match /inspectionPlans/{id} {
      allow read:   if inspectionReader();
      allow delete: if canEditArea('inspection') || canEditArea('inspectionApprove');
      allow create, update: if (canEditArea('inspection') || canEditArea('inspectionApprove')) && idMatches(id);
    }
    match /inspections/{id} {
      allow read:   if inspectionReader();
      allow create: if isOwner() || (canEditArea('inspection') && newRecord(id));
      allow delete: if isOwner() || (canEditArea('inspection') && isOpen(resource.data));
      allow update: if isOwner()
                    || (idMatches(id) && canEditArea('inspection') && (editorWrite() || withdrawWrite()))
                    || (canEditArea('inspectionApprove') && approverWrite())
                    // After approval, whoever keeps the damage log records
                    // that the findings were carried into it — that stamp
                    // and nothing else.
                    || (canEditArea('damage') && apprOf(resource.data) == 'approved'
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['appliedAt', 'appliedBy', 'appliedDamageIds', 'updatedAt']));
    }
    // One photo per component. Changes only while its report is open, like
    // workLogPhotos; a report not written yet is one being created (the app
    // writes the photos first).
    function inspectionOpen(id) {
      return exists(/databases/$(database)/documents/inspections/$(id))
          ? isOpen(get(/databases/$(database)/documents/inspections/$(id)).data)
          : true;
    }
    match /inspectionPhotos/{id} {
      allow read:  if canViewArea('inspection') || canViewArea('inspectionApprove');
      allow write: if isOwner() || (canEditArea('inspection') && inspectionOpen(id));
    }

    // ---- Warehouse ----
    // One area covers both shapes: devices followed by serial number, and
    // consumables counted by quantity. Reads stay open to any active user so
    // anyone can check what is in stock before driving to the warehouse.
    match /devices/{id}    { allow read: if isActive(); allow delete: if canEditArea('warehouse');
                             allow create, update: if canEditArea('warehouse') && idMatches(id); }
    match /stockItems/{id} { allow read: if isActive(); allow delete: if canEditArea('warehouse');
                             allow create, update: if canEditArea('warehouse') && idMatches(id); }

    // ---- Accounts ----
    // Sign-up may only ever create a PENDING VIEWER. Without this, any signed-in
    // user could write {role:'owner', status:'active'} to their own document and
    // take over the whole project. Role/access changes are owner-only.
    // The owner is pinned by Firebase Auth UID, which nobody can claim by
    // registering an address. (Pinned by e-mail, anyone could register the
    // owner's address the moment the original account was deleted or its
    // e-mail changed, and make themselves Super Admin.) Keep in sync with
    // OWNER_UIDS in firebase-init.js.
    function isOwnerAccount() {
      return isSignedIn() && request.auth.uid in ['vWZZ3jz1LTdzrU5c5Q1Gzco8nh72'];
    }
    function selfBootstrapsAsOwner() {
      return isOwnerAccount()
             && request.resource.data.role == 'owner'
             && request.resource.data.status == 'active';
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isOwner());

      // Own document only, and only as a pending viewer with no access map —
      // except the allowlisted owner, which bootstraps itself.
      allow create: if isSignedIn() && request.auth.uid == uid && (
                      (request.resource.data.role == 'viewer'
                       && request.resource.data.status == 'pending'
                       && !('access' in request.resource.data)
                       // A sign-up describes itself truthfully and briefly:
                       // its own uid and e-mail (so the owner approves the
                       // person they think they are approving), no extra
                       // fields, a short name.
                       && request.resource.data.get('uid', uid) == uid
                       && request.resource.data.get('email', '') == request.auth.token.email
                       && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'role',
                            'status', 'createdAt', 'updatedAt', 'updatedBy'])
                       && request.resource.data.get('displayName', '') is string
                       && request.resource.data.get('displayName', '').size() <= 80)
                      || selfBootstrapsAsOwner()
                    );

      // Owners manage everyone. The allowlisted owner may also repair its own
      // document (otherwise a demoted owner can never recover — isOwner() is
      // already false at that point).
      //
      // The third clause is what makes one-session-per-account possible: a
      // signed-in user may claim the session slot on their OWN document, and
      // affectedKeys().hasOnly() pins that to the single 'activeSession' field.
      // Role, status and access stay owner-only, so this opens no path to
      // self-promotion.
      allow update: if isOwner()
                    || (request.auth.uid == uid && selfBootstrapsAsOwner())
                    || (request.auth.uid == uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['activeSession'])
                        // The session record is shown on the owner's Users
                        // page: a fixed, small shape.
                        && request.resource.data.activeSession.keys().hasOnly(['id', 'startedAt', 'device'])
                        && request.resource.data.activeSession.get('id', '') is string
                        && request.resource.data.activeSession.get('id', '').size() <= 80
                        && request.resource.data.activeSession.get('device', '') is string
                        && request.resource.data.activeSession.get('device', '').size() <= 80);

      allow delete: if isOwner();
    }

    // ---- Audit log ----
    // Append-only: events can be created by any editor but never edited, and
    // the actor must be the signed-in user. Only owners may clear history.
    match /history/{eventId} {
      allow read:   if canViewArea('history');
      // Bound to the signed-in person: uid AND e-mail, the event's own id,
      // a known set of fields, and no timestamp far in the future (that
      // pinned forged rows above the real ones in the live feed).
      allow create: if canEditAnything()
                    && request.resource.data.actorUid == request.auth.uid
                    && request.resource.data.get('actorEmail', '') == request.auth.token.email
                    && request.resource.data.get('id', eventId) == eventId
                    && request.resource.data.timestamp is int
                    && request.resource.data.timestamp <= request.time.toMillis() + 86400000
                    && request.resource.data.keys().hasOnly(['id', 'timestamp', 'action', 'unitId',
                         'unitName', 'field', 'before', 'after', 'actorUid', 'actorEmail',
                         'actorName', 'actorRole']);
      allow update: if false;
      allow delete: if isOwner();
    }
  }
}
