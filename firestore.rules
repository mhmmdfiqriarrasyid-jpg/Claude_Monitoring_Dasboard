rules_version = '2';

// ============================================================
// OT Monitoring — Firestore security rules
// ------------------------------------------------------------
// Paste this whole file into: Firebase Console → Firestore → Rules → Publish.
// Keep it in sync with the per-user access model in script.js
// (ACCESS_AREAS / effectiveAccess / hasAccess).
//
// Access model
//   role   : 'owner' (Super Admin) | 'staff' | 'pbt' | 'khl'  (on /users/{uid})
//            'team' and 'viewer' are legacy roles, still honoured unchanged.
//   access : per-area override map, e.g.
//            { editUnits:'edit', implements:'view', damage:'edit',
//              licenseStock:'none', teamShift:'view', teamLog:'edit',
//              teamMembers:'none', teamLogApprove:'edit', warehouse:'edit',
//              inspection:'edit', inspectionApprove:'edit',
//              history:'view', csv:'export' }
//   access.unitScope : 'all' | 'tractor' | 'heavy' (v165) — limits an account
//   to one unit group: the other group's areas close and units/damage are
//   view only. Absent = all; any other value fails closed.
//   Missing override → role default. Only 'owner' (everything) and the legacy
//   'team' (edit) carry defaults; staff/pbt/khl/viewer grant nothing on their
//   own, so every area is granted explicitly in the app's Akses dialog.
//   Owner is always a superuser and can never be locked out.
//   A Damage editor may also move a unit between Good and Breakdown — what
//   a damage record does to its unit — through damageLinkOnly (v162).
//
//   activeSession : { id, startedAt, device } — the one device currently
//   signed in. A user may write this one field on their own document; the
//   newest sign-in wins and every other device signs itself out. An owner's
//   remote sign-out writes the same three keys with an id starting
//   'revoked_'. The app always REPLACES the whole map (never merges into it):
//   a merge kept any other key already stored there, and this shape check
//   then refused every later sign-in of that account.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Identity helpers ----
    function isSignedIn() { return request.auth != null; }
    function myDoc()      { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isActive()   { return isSignedIn() && myDoc().data.status == 'active'; }
    function isOwner()    { return isActive() && myDoc().data.role == 'owner'; }

    // Effective access level for an area: explicit override → role default.
    // .get() with defaults: reading a key the access map does not have is an
    // evaluation ERROR in rules, not null — it happened to deny, but only by
    // accident, and an error inside && / || is easy to get wrong.
    // The helpers below take the user's document data (d) once, so a rule that
    // asks about many areas (canEditAnything) stays within Firestore's limit
    // of 1000 evaluated expressions. Callers check isActive() themselves.
    //
    // Unit-group limit (v165): access.unitScope 'tractor' or 'heavy' limits an
    // account to that group; absent or null = all groups; anything else fails
    // closed ('none'). The owner is never limited.
    // A stored access field that is not a map (only possible by hand in the
    // console) reads as no grants, instead of failing every rule that asks.
    function accessOf(d) {
      let a = d.get('access', {});
      return a is map ? a : {};
    }
    function scopeOf(d) {
      let raw = accessOf(d).get('unitScope', null);
      return d.get('role', '') == 'owner' || raw == null ? 'all'
        : (raw in ['all', 'tractor', 'heavy'] ? raw : 'none');
    }
    // What is granted, narrowed by the limit: the other group's areas close,
    // and units and damage are view only.
    function lvlOf(d, area) {
      let given = accessOf(d).get(area, null);
      let raw = d.get('role', '') == 'owner' ? 'edit'
        : (given != null ? given : (d.get('role', '') == 'team' ? 'edit' : 'none'));
      let sc = scopeOf(d);
      return (sc == 'all' || raw == 'none') ? raw
        : (area in ['implements', 'licenseStock'] && sc != 'tractor') ? 'none'
        : (area in ['inspection', 'inspectionApprove'] && sc != 'heavy') ? 'none'
        : (area in ['editUnits', 'damage'] && raw == 'edit') ? 'view'
        : raw;
    }
    function lvl(area) { return lvlOf(myDoc().data, area); }
    function unitScope() { return scopeOf(myDoc().data); }
    function scopeAllows(g) { return unitScope() in ['all', g]; }
    // A document of a unit group (v167): readable by unlimited accounts, and
    // by a limited one only when it carries that account's group. A limited
    // account must therefore ask with where('unitGroup', '==', <its group>).
    function readsGroupOf(d) {
      let sc = unitScope();
      return sc == 'all' || (sc in ['tractor', 'heavy'] && d.get('unitGroup', '') == sc);
    }
    function canEditArea(area) { return isActive() && lvl(area) == 'edit'; }
    function canViewArea(area) { return isActive() && lvl(area) in ['view', 'edit']; }

    // The stored "id" field, when present, must be the document id: the app
    // builds edit/delete targets from it.
    function idMatches(id) {
      return !('id' in request.resource.data) || request.resource.data.id == id;
    }

    // Edit stored for an area (explicit, or the legacy 'team' default).
    function editOn(a, role, area) {
      let v = a.get(area, null);
      return v == 'edit' || (v == null && role == 'team');
    }
    // True if the user may edit ANY data area — used to gate audit-log writes,
    // since every edit action also appends a history event. Same answer as
    // asking lvl() for each area, with the unit-group limit worked out once.
    function canEditAnything() {
      let d = myDoc().data;
      let a = accessOf(d);
      let role = d.get('role', '');
      let sc = scopeOf(d);
      return isActive() && (role == 'owner'
        || editOn(a, role, 'teamShift') || editOn(a, role, 'teamLog') || editOn(a, role, 'teamMembers')
        || a.get('teamLog', null) == 'own'
        || editOn(a, role, 'purchase') || a.get('purchase', null) == 'own'
        || editOn(a, role, 'learning') || editOn(a, role, 'models3d')
        || editOn(a, role, 'projects') || a.get('projects', null) == 'own'
        || editOn(a, role, 'tickets')
        || editOn(a, role, 'teamLogApprove') || editOn(a, role, 'warehouse')
        || (sc == 'all' && (editOn(a, role, 'editUnits') || editOn(a, role, 'damage')))
        || (sc in ['all', 'tractor'] && (editOn(a, role, 'implements') || editOn(a, role, 'licenseStock')))
        || (sc in ['all', 'heavy'] && (editOn(a, role, 'inspection') || editOn(a, role, 'inspectionApprove'))));
    }

    // A damage record holds its unit (or one component) in Breakdown while it
    // is open and gives it back when it is done. A Damage editor without Unit
    // Database edit may make exactly that change — status, the eight
    // component fields, the reason, the downtime clock, and the id of the
    // damage behind it — and nothing else. Values stay Good / Breakdown, and
    // the downtime log can only grow by the one interval a return to Good
    // closes, so MTBF/MTTR history cannot be wiped from here.
    function downtimeCount(d) {
      return d.get('downtimeHistory', null) is list ? d.get('downtimeHistory', null).size() : 0;
    }
    // The one interval a return to Good closes: it starts where the stored
    // breakdown clock started.
    function closedInterval(iv) {
      return iv is map && iv.keys().hasOnly(['start', 'end', 'durationMs'])
        && iv.start == resource.data.get('breakdownStartedAt', null)
        && iv.end is int && iv.end >= iv.start && iv.end <= request.time.toMillis() + 86400000
        && iv.durationMs == iv.end - iv.start;
    }
    function goodOrBreakdown(ch, k) {
      return !ch.hasAny([k]) || request.resource.data.get(k, '') in ['Good', 'Breakdown'];
    }
    function damageLinkOnly() {
      let ch = request.resource.data.diff(resource.data).affectedKeys();
      return ch.hasOnly(['status', 'breakdownReason', 'breakdownStartedAt', 'downtimeHistory', 'breakdownDamageId',
                         'display', 'gps', 'steering', 'jdlink',
                         'cameraAi', 'telematicBox', 'switchLimiter', 'rotaryLamp'])
        && goodOrBreakdown(ch, 'status')
        && goodOrBreakdown(ch, 'display') && goodOrBreakdown(ch, 'gps')
        && goodOrBreakdown(ch, 'steering') && goodOrBreakdown(ch, 'jdlink')
        && goodOrBreakdown(ch, 'cameraAi') && goodOrBreakdown(ch, 'telematicBox')
        && goodOrBreakdown(ch, 'switchLimiter') && goodOrBreakdown(ch, 'rotaryLamp')
        && (downtimeCount(request.resource.data) - downtimeCount(resource.data)) in [0, 1]
        // Recorded intervals stay exactly as they are; a new one must close the
        // breakdown the server has — a stale release over a newer breakdown
        // is refused.
        && (downtimeCount(resource.data) == 0
            || request.resource.data.downtimeHistory[0:downtimeCount(resource.data)] == resource.data.downtimeHistory)
        && (downtimeCount(request.resource.data) == downtimeCount(resource.data)
            || closedInterval(request.resource.data.downtimeHistory[downtimeCount(resource.data)]))
        // The clock moves only with the status, and to a plausible time.
        && (!ch.hasAny(['breakdownStartedAt']) || (ch.hasAny(['status'])
            && (request.resource.data.breakdownStartedAt == null
                || (request.resource.data.breakdownStartedAt is int
                    && request.resource.data.breakdownStartedAt <= request.time.toMillis() + 86400000
                    && request.resource.data.breakdownStartedAt >= request.time.toMillis() - 30 * 86400000))))
        && (!ch.hasAny(['breakdownDamageId']) || (request.resource.data.breakdownDamageId is string
                                                  && request.resource.data.breakdownDamageId.size() <= 64))
        && (!ch.hasAny(['breakdownReason']) || (request.resource.data.breakdownReason is string
                                                && request.resource.data.breakdownReason.size() <= 1000));
    }

    // ---- Fleet data (one area each) ----
    match /units/{id}         { allow read: if isActive() && readsGroupOf(resource.data); allow delete: if canEditArea('editUnits');
                                allow create: if canEditArea('editUnits') && idMatches(id);
                                allow update: if idMatches(id)
                                  && (canEditArea('editUnits') || (canEditArea('damage') && damageLinkOnly())); }
    match /implements/{id}    { allow read: if isActive() && scopeAllows('tractor'); allow delete: if canEditArea('implements');
                                allow create, update: if canEditArea('implements') && idMatches(id); }
    // A stored group is never blanked (an app tab from before v167 did that on
    // every edit of an agricultural record).
    match /damageRecords/{id} { allow read: if isActive() && readsGroupOf(resource.data); allow delete: if canEditArea('damage');
                                allow create: if canEditArea('damage') && idMatches(id);
                                allow update: if canEditArea('damage') && idMatches(id)
                                  && (resource.data.get('unitGroup', '') == '' || request.resource.data.get('unitGroup', '') != ''); }
    match /licenseStock/{id}  { allow read: if isActive() && scopeAllows('tractor'); allow delete: if canEditArea('licenseStock');
                                allow create, update: if canEditArea('licenseStock') && idMatches(id); }

    // ---- Managed dropdown sources ----
    // User categories are edited from the unit form; damage components from
    // the damage form — so each follows its own area.
    match /userCategories/{catId} { allow read: if isActive(); allow write: if canEditArea('editUnits'); }
    match /damageComponents/{id}  { allow read: if isActive(); allow write: if canEditArea('damage'); }

    // ---- Master lists: Site, Implement Brand, Heavy Equipment Brand, Company ----
    // One document per list. Sites and heavy-equipment brands belong to the
    // unit editors, implement brands to whoever edits implements or units,
    // companies to the team-member editors.
    function canEditMasterList(kind) {
      return (kind in ['site', 'heavyBrand'] && canEditArea('editUnits'))
          || (kind == 'brand' && (canEditArea('implements') || canEditArea('editUnits')))
          || (kind == 'company' && canEditArea('teamMembers'))
          || (kind == 'damageType' && canEditArea('damage'))
          || (kind == 'jobType' && canEditArea('teamMembers'))
          || (kind == 'implGroup' && canEditArea('implements'))
          || (kind == 'learnCategory' && canEditArea('learning'))
          || (kind == 'deviceType' && canEditArea('warehouse'))
          || (kind == 'uom' && canEditArea('purchase'))
          || (kind in ['jobCategory', 'department'] && canEditArea('projects'))
          || (kind == 'ticketCategory' && canEditArea('tickets'));
    }
    // Paddocks (2.10.0): one list per company, chosen from in Daily Reports.
    // Read by every active account; kept by whoever manages team members.
    match /paddocks/{id} {
      allow read: if isActive();
      allow delete: if canEditArea('teamMembers');
      allow create, update: if canEditArea('teamMembers')
        && request.resource.data.get('id', '') == id
        && request.resource.data.get('company', '') is string
        && request.resource.data.get('company', '').size() > 0
        && request.resource.data.get('company', '').size() <= 120
        && request.resource.data.get('items', null) is list
        && request.resource.data.get('items', []).size() <= 3000;
    }
    match /masterLists/{kind} {
      allow read: if isActive();
      allow delete: if canEditMasterList(kind);
      allow create, update: if canEditMasterList(kind)
        && request.resource.data.id == kind
        && request.resource.data.values is list
        && request.resource.data.values.size() <= 500;
    }

    // ---- License requirements per implement type (purchase plan) ----
    // Set by whoever manages license stock; only the known license values.
    match /licenseRequirements/{id} {
      allow read: if isActive() && scopeAllows('tractor');
      allow delete: if canEditArea('licenseStock');
      allow create, update: if canEditArea('licenseStock')
        && request.resource.data.id == id
        && request.resource.data.get('gps', '') in ['', 'SF-1', 'SF-RTK']
        && request.resource.data.get('display', '') in ['', 'G5 Basic', 'G5 Advance']
        && request.resource.data.get('type', '') is string
        && request.resource.data.get('type', '').size() <= 120;
    }

    // ---- Team operations (one area each) ----
    // Split three ways on purpose: someone may read the schedule without
    // setting it, and file their daily report without touching the roster.
    // Reads stay open to any active user so people can see who is on duty.
    //
    // Work logs are deliberately NOT restricted to their own author: an office
    // admin files reports on behalf of field operators who have no login. Every
    // write is still attributed in /history, so who filed what stays traceable.
    // 2.16.0: accountUid/accountEmail link a member to a sign-in account; only
    // the owner sets or changes that link.
    match /teamMembers/{id} { allow read: if isActive(); allow delete: if canEditArea('teamMembers');
                              allow create: if canEditArea('teamMembers') && idMatches(id)
                                && (isOwner() || !request.resource.data.keys().hasAny(['accountUid', 'accountEmail']));
                              allow update: if canEditArea('teamMembers') && idMatches(id)
                                && (isOwner() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['accountUid', 'accountEmail'])); }
    match /shifts/{id}      { allow read: if isActive(); allow delete: if canEditArea('teamShift');
                              allow create, update: if canEditArea('teamShift') && idMatches(id)
                                && request.resource.data.get('shift', '') in ['pagi', 'siang', 'malam', 'libur', '']; }

    // ---- Approval (work logs, leave requests, heavy-equipment checks) ----
    // Enforced HERE, not only in the app: from the browser console anyone
    // with teamLog edit could otherwise write approval:'approved' under a
    // supervisor's name, and an approver could approve their own report.
    //
    // The flow:  draft ──Kirim──▶ pending ──Setujui──▶ approved
    //              ▲                │  │                  │
    //              └─Tarik kembali──┘  └──Minta revisi──▶ revision ◀──┘
    //            draft / revision are open to editors; pending and
    //            approved are locked until the checker acts.
    // Records written before approval existed have no field: pending.
    //
    // Two accounts are recorded, and the checker may be neither of them:
    //   createdByUid   — who filed it. Required on create (no default — a
    //                    create that left it out used to pass as "nobody's"),
    //                    and never rewritten afterwards.
    //   submittedByUid — who sent THIS version for checking. Stamped by the
    //                    sender on every write that leaves the record
    //                    pending. Needed because an open record (a draft, or
    //                    one sent back for revision) may be changed by any
    //                    editor: without it, someone holding both the edit
    //                    and the approve grant could rewrite a colleague's
    //                    sent-back report, send it, and approve their own
    //                    words under the colleague's name.
    // Records from before either field existed carry neither; those still
    // follow the createdByUid check (an empty one matches nobody).
    function apprOf(d)     { return d.get('approval', 'pending'); }
    function isOpen(d)     { return apprOf(d) in ['draft', 'revision']; }
    function approvalKeys() {
      return ['approval', 'approvedBy', 'approvedByEmail', 'approvedAt',
              'revisionNote', 'reviewedBy', 'reviewedAt', 'updatedAt'];
    }
    // Whoever leaves a record pending signs as its sender, with their own uid.
    function sentBySelf() {
      return apprOf(request.resource.data) != 'pending'
          || request.resource.data.get('submittedByUid', '') == request.auth.uid;
    }
    // An editor changes an OPEN record, and leaves it a draft or sends it —
    // never approved, never under someone's signature, and never as someone
    // else's: the author cannot be rewritten, and the sender is the editor.
    function editorWrite() {
      return isOpen(resource.data)
          && apprOf(request.resource.data) in ['draft', 'pending']
          && request.resource.data.get('approvedByEmail', '') == ''
          && request.resource.data.get('createdByUid', '') == resource.data.get('createdByUid', '')
          && sentBySelf();
    }
    // Tarik kembali: the sender pulls a pending record back to a draft before
    // anyone has checked it, and changes nothing else on the way.
    function withdrawWrite() {
      return apprOf(resource.data) == 'pending'
          && request.resource.data.get('approval', '') == 'draft'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approval', 'updatedAt'])
          && resource.data.get('createdByUid', '') in ['', request.auth.uid];
    }
    // An approver touches the approval fields only, never checks a record
    // they filed or sent themselves, approves only what was sent, signs with
    // their own e-mail, and sends back — with a reason — only what was sent
    // or already approved.
    function approverWrite() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(approvalKeys())
          && resource.data.get('createdByUid', '') != request.auth.uid
          && resource.data.get('submittedByUid', '') != request.auth.uid
          && ((request.resource.data.get('approval', '') == 'approved'
                && apprOf(resource.data) == 'pending'
                && request.resource.data.get('approvedByEmail', '') == request.auth.token.email)
              || (request.resource.data.get('approval', '') == 'revision'
                && apprOf(resource.data) in ['pending', 'approved']
                && request.resource.data.get('revisionNote', '') is string
                && request.resource.data.get('revisionNote', '').size() > 0));
    }
    // A new record names its author — the signed-in account — and, when it
    // is sent straight away, its sender too.
    function newRecord(id) {
      return idMatches(id)
          && apprOf(request.resource.data) in ['draft', 'pending']
          && request.resource.data.get('approvedByEmail', '') == ''
          && request.resource.data.get('createdByUid', '') == request.auth.uid
          && sentBySelf();
    }
    function teamLogReader() {
      return canViewArea('teamLog') || canViewArea('teamLogApprove') || canViewArea('leader');
    }
    // Daily Report 'own' (v175): files reports and leave, and reads, changes
    // and deletes only the ones it filed — while they are open. Its queries
    // must ask where('createdByUid', '==', <its uid>).
    function teamLogOwn() { return isActive() && lvl('teamLog') == 'own'; }
    function mineIn(d)    { return d.get('createdByUid', '') == request.auth.uid; }

    // Work logs are written by whoever may edit them, and approved by whoever
    // holds 'teamLogApprove' — a separate grant, so a checker need not be able
    // to rewrite the report they are checking. affectedKeys().hasOnly() is what
    // enforces that: an approver's write may touch the approval fields and
    // nothing else, so they cannot quietly change the hours or the description
    // on their way past. Deleting follows editing: only an open record.
    // 2.16.0: an 'own' account files only as itself — the member must be
    // linked to it, or not linked to anyone yet.
    function memberMine() {
      let p = /databases/$(database)/documents/teamMembers/$(request.resource.data.get('memberId', '-'));
      return !exists(p) || get(p).data.get('accountUid', '') in ['', request.auth.uid];
    }
    match /workLogs/{id} {
      allow read:   if teamLogReader() || (teamLogOwn() && mineIn(resource.data));
      // 2.45.0: never an lv_ id — that is a leave request's (teamRecPath and storage.rules pick the
      // record by it, so a work log under one would keep its own approved evidence swappable).
      allow create: if isOwner() || (!id.matches('lv_.*') && canEditArea('teamLog') && newRecord(id))
                    || (!id.matches('lv_.*') && teamLogOwn() && newRecord(id) && memberMine());
      allow delete: if isOwner() || (canEditArea('teamLog') && isOpen(resource.data))
                    || (teamLogOwn() && mineIn(resource.data) && isOpen(resource.data));
      allow update: if isOwner()
                    || (idMatches(id) && canEditArea('teamLog') && (editorWrite() || withdrawWrite()))
                    || (idMatches(id) && teamLogOwn() && mineIn(resource.data) && memberMine() && (editorWrite() || withdrawWrite()))
                    || (canEditArea('teamLogApprove') && approverWrite());
    }

    // Izin / sakit. Areanya sama dengan laporan harian: orang yang mencatat
    // laporan tim adalah orang yang mencatat izinnya, dan atasan yang
    // menyetujui laporan adalah atasan yang menyetujui izin. Tidak ada izin
    // baru yang perlu diatur per orang.
    //
    // Klausa hasOnly-nya menahan hal yang sama seperti di workLogs: tanpa itu,
    // siapa pun yang boleh menyetujui juga bisa diam-diam mengubah tanggal dan
    // alasannya, lalu menyetujui versi yang sudah ia ubah sendiri.
    //
    // Surat sakit / surat izin TIDAK punya koleksi sendiri — ia menumpang
    // workLogPhotos di bawah ini. Bentuknya sama persis dan areanya sama
    // persis, jadi memberinya koleksi sendiri hanya akan menambah satu lagi
    // jalur yang menunggu publish, dengan kegagalan yang tidak bisa dibedakan.
    // Leave reasons are personal; the shift grid shows approved leave, so
    // whoever can see the schedule may read them too.
    match /leaveRequests/{id} {
      allow read:   if teamLogReader() || canViewArea('teamShift') || (teamLogOwn() && mineIn(resource.data));
      // 2.45.0: always an lv_ id (generateLeaveId), the one teamRecPath and storage.rules look for.
      allow create: if isOwner() || (id.matches('lv_.*') && (canEditArea('teamLog') || teamLogOwn()) && newRecord(id));
      allow delete: if isOwner() || (canEditArea('teamLog') && isOpen(resource.data))
                    || (teamLogOwn() && mineIn(resource.data) && isOpen(resource.data));
      allow update: if isOwner()
                    || (idMatches(id) && canEditArea('teamLog') && (editorWrite() || withdrawWrite()))
                    || (idMatches(id) && teamLogOwn() && mineIn(resource.data) && (editorWrite() || withdrawWrite()))
                    || (canEditArea('teamLogApprove') && approverWrite());
    }

    // Photos and letters follow their record: they change only while it is
    // open, so a sent or approved report cannot have its evidence swapped
    // underneath it. No record yet means one being created — the app writes
    // the photos first, then the record.
    // 2.45.0: the record is the one its id names — work logs are wl_…, leave
    // requests lv_… (as storage.rules picks it). A draft work log made with a
    // leave request's id used to unlock that request's approved letter.
    function teamRecPath(id) {
      return id.matches('lv_.*') ? /databases/$(database)/documents/leaveRequests/$(id)
                                 : /databases/$(database)/documents/workLogs/$(id);
    }
    function recordOpen(id) {
      return exists(teamRecPath(id)) ? isOpen(get(teamRecPath(id)).data) : true;
    }

    // Field documentation photos, one document per report. Split out of the
    // work log itself because workLogs is subscribed whole, with no limit —
    // inline photos meant every device re-downloaded every photo on every app
    // open. Same area as the report: whoever may edit a report may edit its
    // photos, so there is no new permission to hand out per person.
    // Holds sick-leave letters — medical data. Only people who work with
    // reports and leave may read it.
    // The record a photo belongs to was filed by this account ('own'); with
    // no record yet (photos are written first) it is about to be.
    function recordMine(id, orNew) {
      return exists(teamRecPath(id)) ? mineIn(get(teamRecPath(id)).data) : orNew;
    }
    // 2.26.1: the photos may still follow a report its sender has just sent.
    // Since 2.17.0 the images are uploaded to Storage before their document is
    // written, so the report (now pending) often reaches the server first —
    // and the photos were then refused, leaving a report that says "3 photos"
    // with none behind it. Only the sender, only while it is pending; once it
    // is approved or sent back the photos are locked or open as before.
    function sentByMe(d) { return apprOf(d) == 'pending' && d.get('submittedByUid', '') == request.auth.uid; }
    function recordSentByMe(id) {
      return exists(teamRecPath(id)) && sentByMe(get(teamRecPath(id)).data);
    }
    match /workLogPhotos/{id} {
      allow read:  if canViewArea('teamLog') || canViewArea('teamLogApprove')
                    || (teamLogOwn() && recordMine(id, false));
      allow write: if isOwner() || (canEditArea('teamLog') && (recordOpen(id) || recordSentByMe(id)))
                    || (teamLogOwn() && (recordOpen(id) || recordSentByMe(id)) && recordMine(id, true));
    }

    // Damage photos, one document per record. Split out for the same reason as
    // workLogPhotos: damageRecords is subscribed whole, with no limit, so an
    // inline photo was re-downloaded by every device on every app open — and it
    // rode along into localStorage, where a few dozen of them filled the origin
    // quota and silently stopped unit saves and the automatic backup. Same area
    // as the record: whoever may edit a damage record may edit its photo, so
    // there is no new permission to hand out per person.
    // A photo goes by its damage record (the After photo is "<id>__after").
    match /damagePhotos/{id} {
      allow read:  if canViewArea('damage')
                    && (unitScope() == 'all'
                        || readsGroupOf(get(/databases/$(database)/documents/damageRecords/$(id.split('__after')[0])).data));
      allow write: if canEditArea('damage');
    }

    // ---- Heavy-equipment checks ----
    // Same draft → sent → approved / sent-back flow as the daily report, with
    // its own two grants: 'inspection' for the technician who checks and
    // files, 'inspectionApprove' for the supervisor who signs off. The
    // approval functions above are reused unchanged.
    function inspectionReader() {
      return (canViewArea('inspection') || canViewArea('inspectionApprove') || canViewArea('leader'))
          && scopeAllows('heavy');
    }
    // The schedule is set by whoever checks or approves.
    match /inspectionPlans/{id} {
      allow read:   if inspectionReader();
      allow delete: if canEditArea('inspection') || canEditArea('inspectionApprove');
      allow create, update: if (canEditArea('inspection') || canEditArea('inspectionApprove')) && idMatches(id);
    }
    // 2.45.0: what was carried into the damage log. appliedKeys (the components
    // logged) decides what a report approved again after a reopen still has to
    // log, so only the damage log's keepers stamp it — never the report's author.
    function insAppliedKeys() { return ['appliedAt', 'appliedBy', 'appliedDamageIds', 'appliedKeys']; }
    match /inspections/{id} {
      allow read:   if inspectionReader();
      allow create: if isOwner() || (canEditArea('inspection') && newRecord(id)
                                     && !request.resource.data.keys().hasAny(insAppliedKeys()));
      allow delete: if isOwner() || (canEditArea('inspection') && isOpen(resource.data));
      allow update: if isOwner()
                    || (idMatches(id) && canEditArea('inspection') && (editorWrite() || withdrawWrite())
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(insAppliedKeys()))
                    || (canEditArea('inspectionApprove') && approverWrite())
                    // After approval, whoever keeps the damage log records
                    // that the findings were carried into it — that stamp
                    // and nothing else.
                    || (canEditArea('damage') && apprOf(resource.data) == 'approved'
                        && request.resource.data.get('appliedKeys', []) is list
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(insAppliedKeys().concat(['updatedAt'])));
    }
    // One photo per component. Changes only while its report is open, like
    // workLogPhotos; a report not written yet is one being created (the app
    // writes the photos first).
    function inspectionOpen(id) {
      return exists(/databases/$(database)/documents/inspections/$(id))
          ? isOpen(get(/databases/$(database)/documents/inspections/$(id)).data)
          : true;
    }
    // 2.45.0: as workLogPhotos (2.26.1) — the app saves a report and its photos at the
    // same time, and the photos (uploaded to Storage first) reach the server after the
    // report, which is then already pending. Its sender may still finish them while it
    // waits for the check; approved or sent back, they are locked or open as before.
    function inspectionSentByMe(id) {
      return exists(/databases/$(database)/documents/inspections/$(id))
          && sentByMe(get(/databases/$(database)/documents/inspections/$(id)).data);
    }
    match /inspectionPhotos/{id} {
      allow read:  if canViewArea('inspection') || canViewArea('inspectionApprove');
      allow write: if isOwner() || (canEditArea('inspection') && (inspectionOpen(id) || inspectionSentByMe(id)));
    }

    // ---- Warehouse ----
    // One area covers both shapes: devices followed by serial number, and
    // consumables counted by quantity. Reads stay open to any active user so
    // anyone can check what is in stock before driving to the warehouse.
    match /devices/{id}    { allow read: if isActive(); allow delete: if canEditArea('warehouse');
                             allow create, update: if canEditArea('warehouse') && idMatches(id); }
    match /stockItems/{id} { allow read: if isActive(); allow delete: if canEditArea('warehouse');
                             allow create, update: if canEditArea('warehouse') && idMatches(id); }
    // Operational vehicles (company motorbikes) and their fuel log: the same
    // area. A fuel receipt photo is one document per record and only
    // warehouse viewers may open it.
    match /vehicles/{id}   { allow read: if isActive(); allow delete: if canEditArea('warehouse');
                             allow create, update: if canEditArea('warehouse') && idMatches(id); }
    match /fuelLogs/{id}   { allow read: if isActive(); allow delete: if canEditArea('warehouse');
                             allow create, update: if canEditArea('warehouse') && idMatches(id); }
    match /fuelPhotos/{id} { allow read: if canViewArea('warehouse'); allow write: if canEditArea('warehouse'); }
    // ---- Purchase requests (2.9.0) ----
    // 'edit' manages every request (approve, PO, receive). 'own' files its own
    // requests and changes them only while they are drafts; it reads only
    // those (queries must ask where('createdByUid', '==', <its uid>)).
    function purchaseOwn() { return isActive() && lvl('purchase') == 'own'; }
    match /purchaseRequests/{id} {
      allow read:   if canViewArea('purchase') || (purchaseOwn() && mineIn(resource.data));
      allow create: if idMatches(id) && newIdOk(id) && request.resource.data.get('createdByUid', '') == request.auth.uid
                    && (canEditArea('purchase')
                        || (purchaseOwn() && request.resource.data.get('status', '') in ['draft', 'submitted']
                            // 2.43.0: a request goods were never received for has no receipts yet
                            && request.resource.data.get('receipts', []) == []));
      allow update: if idMatches(id) && (canEditArea('purchase')
                    || (purchaseOwn() && mineIn(resource.data) && resource.data.get('status', '') == 'draft'
                        && request.resource.data.get('createdByUid', '') == request.auth.uid
                        && request.resource.data.get('status', '') in ['draft', 'submitted']
                        && request.resource.data.get('receipts', []) == []));
      allow delete: if canEditArea('purchase')
                    || (purchaseOwn() && mineIn(resource.data) && resource.data.get('status', '') == 'draft');
    }
    // ---- Projects & Jobs (2.29.0) ----
    // Projects (with other departments, one unit or many) and the jobs done
    // outside the Daily Report (calibration, implement installs, meetings…).
    // 'edit' keeps all of them; 'own' adds its own and changes only those;
    // 'view' reads. Whoever may open the area reads every project and job.
    function projectsOwn()  { return isActive() && lvl('projects') == 'own'; }
    function projectsRead() { return canViewArea('projects') || projectsOwn(); }
    function projectsKeep(d) {
      return canEditArea('projects')
          || (projectsOwn() && mineIn(d) && request.resource.data.get('createdByUid', '') == request.auth.uid);
    }
    function textOk(field, max) {
      return request.resource.data.get(field, '') is string
          && request.resource.data.get(field, '').size() > 0
          && request.resource.data.get(field, '').size() <= max;
    }
    // 2.43.0: a manual RAG is one of the known values (it is drawn into a class name).
    function ragOk() { return request.resource.data.get('ragOverride', '') in ['', 'green', 'amber', 'red']; }
    // 2.43.2: a new record's id has the app's shape (projects.js _pjId: pj_… / job_…,
    // never "__"): a job named like a project, or a request named like a receipt, made
    // another record's photos look like its own when it was deleted.
    function newIdOk(id) { return !id.matches('.*__.*'); }
    match /projects/{id} {
      allow read:   if projectsRead();
      allow create: if idMatches(id) && newIdOk(id) && !id.matches('job_.*') && textOk('name', 200) && ragOk()
                    && request.resource.data.get('createdByUid', '') == request.auth.uid
                    && (canEditArea('projects') || projectsOwn());
      allow update: if idMatches(id) && textOk('name', 200) && ragOk() && projectsKeep(resource.data);
      allow delete: if canEditArea('projects') || (projectsOwn() && mineIn(resource.data));
    }
    match /otJobs/{id} {
      allow read:   if projectsRead();
      allow create: if idMatches(id) && newIdOk(id) && id.matches('job_.*') && textOk('category', 80)
                    && request.resource.data.get('createdByUid', '') == request.auth.uid
                    && (canEditArea('projects') || projectsOwn());
      allow update: if idMatches(id) && textOk('category', 80) && projectsKeep(resource.data);
      allow delete: if canEditArea('projects') || (projectsOwn() && mineIn(resource.data));
    }
    // ---- Photos of one record (2.43.0) ----
    // A photo document is named <record>__p<n> (a receipt: <request>__<receipt>__p<n>),
    // so the record it belongs to is the part of its id before the first "__".
    // An 'own' account touches only the photos of its own records: it used to be
    // able to replace or delete anybody's. A record already gone (deleted just
    // before its photos) leaves orphans that may still be removed.
    function recOfPhoto(id) { return id.split('__')[0]; }
    function recMine(path, orGone) { return exists(path) ? mineIn(get(path).data) : orGone; }
    // Jobs are named job_…, projects pj_… (projects.js _pjId).
    function pjRecPath(rid) {
      return rid.matches('job_.*') ? /databases/$(database)/documents/otJobs/$(rid)
                                  : /databases/$(database)/documents/projects/$(rid);
    }
    function prRecPath(rid) { return /databases/$(database)/documents/purchaseRequests/$(rid); }
    // The stored picture: inline, still on the sender's phone, or a Storage file in
    // this document's own folder — never a path elsewhere in the bucket (whoever
    // later deletes the photo would delete that file with their own rights).
    function photoValOk(col, id) {
      let v = request.resource.data.get('photo', '');
      return id.matches('[A-Za-z0-9_-]+') && v is string && v.size() <= 400000
          && (v == '' || v.matches('data:image/.*') || v.matches('pending:[a-z0-9]+')
              || v.matches('sp:photos/' + col + '/' + id + '/[A-Za-z0-9_-]+'));
    }
    // The photo stays with the record it was taken for.
    function photoOwnerKept(id) {
      return recOfPhoto(request.resource.data.get('ownerId', '')) == recOfPhoto(id)
          && (resource == null || resource.data.get('ownerId', '') == request.resource.data.get('ownerId', ''));
    }
    match /projectPhotos/{id} {
      allow read:   if projectsRead();
      allow delete: if canEditArea('projects') || (projectsOwn() && recMine(pjRecPath(recOfPhoto(id)), true));
      allow create, update: if idMatches(id) && photoValOk('projectPhotos', id)
                    && (canEditArea('projects')
                        || (projectsOwn() && photoOwnerKept(id) && recMine(pjRecPath(recOfPhoto(id)), false)));
    }
    // ---- Tickets (2.30.0) ----
    // Every active account files tickets and follows its own (queries must ask
    // where('reportedByUid', '==', <its uid>)). 'view' reads all of them;
    // 'edit' (the OT team) assigns, works and resolves them. The reporter may
    // only add to the timeline, and close or reopen once it is resolved.
    function ticketMine(d) { return d.get('reportedByUid', '') == request.auth.uid; }
    function ticketOk() {
      return textOk('title', 160) && textOk('category', 80)
          && request.resource.data.get('priority', '') in ['high', 'medium', 'low']
          && request.resource.data.get('status', '') in ['open', 'assigned', 'progress', 'resolved', 'closed']
          && request.resource.data.get('events', []) is list && request.resource.data.get('events', []).size() <= 300
          && tkNumOk('reportedAt') && tkNumOk('updatedAt') && tkNumOk('resolvedAt') && tkNumOk('closedAt');
    }
    // 2.45.0: the times are numbers (or left out / cleared): a map there stopped the sort of
    // the Tickets page and the reports for everyone.
    function tkNumOk(k) {
      return request.resource.data.get(k, null) == null || request.resource.data.get(k, null) is number;
    }
    // 2.45.0: whoever is not on the OT team writes only as itself. A new ticket is a fresh
    // one — open, no PIC, no resolution or close stamps, at most its one 'created' event —
    // under the account's own name and e-mail; afterwards the reporter adds exactly ONE
    // event of its own to the end of the timeline (the earlier ones stay as they are) with
    // its comment, close or reopen, and a reopen clears resolvedAt. A forged timeline, PIC
    // or 'resolved' stamp used to reach the OT team's pushes and the managers' reports.
    // The name the app signs with (tickets.js _tkMe): the profile name, else the e-mail's
    // part before the '@'.
    function myName() {
      let n = myDoc().data.get('displayName', '');
      return (n is string && n != '') ? n : request.auth.token.get('email', '').split('@')[0];
    }
    function msNear(v) {
      return v is int && v <= request.time.toMillis() + 86400000 && v >= request.time.toMillis() - 30 * 86400000;
    }
    function tkEventOk(ev, types) {
      return ev is map && ev.keys().hasOnly(['at', 'by', 'byUid', 'type', 'text'])
          && ev.get('type', '') in types
          && ev.get('byUid', '') == request.auth.uid && ev.get('by', '') == myName()
          && ev.get('at', 0) is int && ev.get('at', 0) <= request.time.toMillis() + 86400000
          && ev.get('text', '') is string && ev.get('text', '').size() <= 2000;
    }
    function tkFresh() {
      let d = request.resource.data;
      let ev = d.get('events', []);
      return d.keys().hasOnly(['id', 'no', 'title', 'category', 'priority', 'description', 'location', 'units', 'company',
                               'photoIds', 'status', 'reportedByUid', 'reportedBy', 'reportedByEmail', 'reportedAt',
                               'assigneeUid', 'assigneeName', 'jobIds', 'events', 'updatedAt', 'lastActorUid'])
          && d.get('assigneeUid', '') == '' && d.get('assigneeName', '') == ''
          && d.get('jobIds', []) is list && d.get('jobIds', []).size() <= 1
          && d.get('reportedBy', '') == myName()
          && d.get('reportedByEmail', '') == request.auth.token.get('email', '')
          && msNear(d.get('reportedAt', null))
          && d.get('lastActorUid', request.auth.uid) == request.auth.uid
          && (ev.size() == 0 || (ev.size() == 1 && tkEventOk(ev[0], ['created'])));
    }
    // The reporter's one step: a note (status unchanged), or its answer to a resolved
    // ticket — fixed (closed) or not (open again, no longer resolved). At the cap of 300
    // events the app drops the oldest, so the kept ones move up by one.
    function tkReporterWrite() {
      let o = resource.data;
      let d = request.resource.data;
      let ch = d.diff(o).affectedKeys();
      let olds = o.get('events', []);
      let evs = d.get('events', []);
      let n = olds.size();
      let s0 = o.get('status', '');
      let s1 = d.get('status', '');
      let move = s1 == s0 ? 'comment'
               : (s0 == 'resolved' && s1 == 'closed') ? 'closed'
               : (s0 == 'resolved' && s1 == 'open') ? 'reopen' : '';
      return move != ''
          && ch.hasOnly(['events', 'status', 'closedAt', 'resolvedAt', 'updatedAt', 'lastActorUid'])
          && d.get('lastActorUid', '') == request.auth.uid
          && ((evs.size() == n + 1 && evs[0:n] == olds)
              || (n == 300 && evs.size() == 300 && evs[0:299] == olds[1:300]))
          && tkEventOk(evs[evs.size() - 1], [move])
          && (move == 'comment' ? !ch.hasAny(['closedAt', 'resolvedAt'])
              : move == 'closed' ? (!ch.hasAny(['resolvedAt']) && msNear(d.get('closedAt', null)))
              : (d.get('resolvedAt', null) == null && d.get('closedAt', null) == null));
    }
    match /tickets/{id} {
      allow read:   if canViewArea('tickets') || (isActive() && ticketMine(resource.data));
      allow create: if isActive() && idMatches(id) && newIdOk(id) && ticketOk()
                    && request.resource.data.get('reportedByUid', '') == request.auth.uid
                    && request.resource.data.get('status', '') == 'open'
                    && (canEditArea('tickets') || tkFresh());
      allow update: if idMatches(id) && ticketOk() && (canEditArea('tickets')
                    || (isActive() && ticketMine(resource.data)
                        && request.resource.data.get('reportedByUid', '') == request.auth.uid
                        && tkReporterWrite()));
      allow delete: if canEditArea('tickets');
    }
    // Photos of a ticket: its reporter and whoever may see tickets.
    // 2.43.0: the ticket is the one the photo's id names, and it must exist and be
    // the reporter's own. A made-up ticket id used to let anyone write any ticket's photo.
    function ticketOfPhoto(tid) { return /databases/$(database)/documents/tickets/$(tid); }
    function ticketPhotoMine(id) {
      return exists(ticketOfPhoto(recOfPhoto(id))) && ticketMine(get(ticketOfPhoto(recOfPhoto(id))).data);
    }
    match /ticketPhotos/{id} {
      allow read:   if canViewArea('tickets') || (isActive() && (resource == null || ticketPhotoMine(id)));
      allow create, update: if isActive() && idMatches(id) && photoValOk('ticketPhotos', id)
                    && (canEditArea('tickets') || (photoOwnerKept(id) && ticketPhotoMine(id)));
      allow delete: if canEditArea('tickets');
    }
    // Who can be given a ticket: each OT account writes its own card here.
    match /ticketStaff/{uid} {
      allow read:   if canViewArea('tickets');
      allow write:  if canEditArea('tickets') && uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'updatedAt'])
                    && request.resource.data.get('uid', '') == uid;
      allow delete: if isOwner() || uid == request.auth.uid;
    }
    // 3D Models (2.44.0): every active account opens them; 'models3d' edit adds,
    // changes and removes. A model is one file in Storage, models3d/<id>/<file>
    // (a GLB, or a studio page kept as text), plus an optional card picture.
    function m3Ok(id) {
      let d = request.resource.data;
      return idMatches(id) && id.matches('m3_[a-z0-9]+') && textOk('name', 160)
          && d.get('kind', '') in ['studio', 'glb']
          && d.get('file', null) is map
          && d.file.get('path', '') is string && d.file.get('path', '').matches('models3d/' + id + '/[A-Za-z0-9_.-]+')
          && d.get('thumb', '') is string && (d.get('thumb', '') == '' || d.get('thumb', '') == 'models3d/' + id + '/thumb.jpg')
          && d.get('category', '') is string && d.get('category', '').size() <= 60
          && d.get('description', '') is string && d.get('description', '').size() <= 2000
          && d.get('implements', []) is list && d.get('implements', []).size() <= 30
          && d.get('unitModels', []) is list && d.get('unitModels', []).size() <= 30
          && d.get('parts', {}) is map && d.get('parts', {}).size() <= 3000;
    }
    match /models3d/{id} {
      allow read: if isActive();
      allow create, update: if canEditArea('models3d') && m3Ok(id);
      allow delete: if canEditArea('models3d');
    }
    // Learning Center (2.12.0): every active account reads; 'learning' edit
    // adds and removes material. Uploaded PDFs are stored in pieces.
    // 2.43.0: an uploaded file is one of the known formats (it picks the reader and a class name).
    function learnFileOk() {
      let f = request.resource.data.get('file', null);
      return f == null || (f is map && f.get('format', 'pdf') in ['pdf', 'epub', 'mobi', 'video']);
    }
    match /learningItems/{id} {
      allow read: if isActive();
      allow delete: if canEditArea('learning');
      allow create, update: if canEditArea('learning') && idMatches(id) && learnFileOk()
        && request.resource.data.get('title', '') is string
        && request.resource.data.get('title', '').size() > 0
        && request.resource.data.get('title', '').size() <= 200;
    }
    match /learningFiles/{id} {
      allow read: if isActive();
      allow delete: if canEditArea('learning');
      allow create, update: if canEditArea('learning') && idMatches(id)
        && request.resource.data.get('data', '') is string
        && request.resource.data.get('data', '').size() <= 950000;
    }
    // Server email (2.14.0, Cloud Functions): the owner sets who gets the
    // licence alert and whether it goes out every morning; License Stock
    // viewers can see that. mailLog is written by the server only.
    match /agriFacts/{id} {
      allow read: if isActive();
      allow delete: if canEditArea('learning');
      allow create, update: if canEditArea('learning') && idMatches(id)
        && request.resource.data.keys().hasOnly(['id', 'term', 'text', 'source', 'url', 'createdAt', 'updatedAt', 'by'])
        && request.resource.data.get('term', '') is string && request.resource.data.get('term', '').size() > 0 && request.resource.data.get('term', '').size() <= 80
        && request.resource.data.get('text', '') is string && request.resource.data.get('text', '').size() > 0 && request.resource.data.get('text', '').size() <= 500
        && request.resource.data.get('source', '') is string && request.resource.data.get('source', '').size() > 0 && request.resource.data.get('source', '').size() <= 120
        && request.resource.data.get('url', '') is string && request.resource.data.get('url', '').matches('https://.+') && request.resource.data.get('url', '').size() <= 500;
    }
    match /settings/{id} {
      allow read: if id == 'agri' && isActive();
      allow write: if id == 'agri' && canEditArea('learning')
        && request.resource.data.keys().hasOnly(['builtIns', 'hidden', 'updatedAt']) && request.resource.data.get('builtIns', true) is bool
        && request.resource.data.get('hidden', []) is list && request.resource.data.get('hidden', []).size() <= 1000;
      // 2.45.0: only whoever opens the Notifications page reads it (script.js
      // canSeeNotifications) — Daily Report and Damage viewers could read every list.
      allow read: if id == 'email' && (isOwner() || canViewArea('licenseStock'));
      allow write: if id == 'email' && isOwner()
        && request.resource.data.keys().hasOnly(['recipients', 'dailyEnabled', 'sendHour',
             'reminderEnabled', 'reminderHour', 'reminderRecipients', 'damageEnabled', 'damageRecipients',
             'monthlyEnabled', 'monthlyHour', 'monthlyRecipients', 'pushDamage', 'pushApprovals', 'pushTickets',
             'sendFreq', 'sendWeekday', 'sendMonthday', 'reminderFreq', 'reminderWeekday', 'reminderMonthday',
             'monthlyFreq', 'monthlyWeekday', 'monthlyMonthday', 'mgrEnabled', 'mgrHour', 'mgrRecipients', 'updatedAt', 'updatedBy'])
        && schedOk(request.resource.data, 'send') && schedOk(request.resource.data, 'reminder') && schedOk(request.resource.data, 'monthly')
        && request.resource.data.get('pushDamage', true) is bool
        && request.resource.data.get('pushApprovals', true) is bool
        && request.resource.data.get('pushTickets', true) is bool
        && emailList(request.resource.data.get('monthlyRecipients', []))
        && emailList(request.resource.data.get('mgrRecipients', []))
        && request.resource.data.get('mgrEnabled', false) is bool
        && hourOk(request.resource.data.get('mgrHour', 7))
        && request.resource.data.get('monthlyEnabled', false) is bool
        && hourOk(request.resource.data.get('monthlyHour', 7))
        && emailList(request.resource.data.get('recipients', []))
        && emailList(request.resource.data.get('reminderRecipients', []))
        && emailList(request.resource.data.get('damageRecipients', []))
        && request.resource.data.get('dailyEnabled', false) is bool
        && request.resource.data.get('reminderEnabled', false) is bool
        && request.resource.data.get('damageEnabled', false) is bool
        && hourOk(request.resource.data.get('sendHour', 7))
        && hourOk(request.resource.data.get('reminderHour', 17));
    }
    function emailList(v) { return v is list && v.size() <= 10; }
    function hourOk(h) { return h is int && h >= 0 && h <= 23; }
    function schedOk(d, p) {
      return d.get(p + 'Freq', 'daily') in ['daily', 'weekly', 'monthly']
        && d.get(p + 'Weekday', 1) is int && d.get(p + 'Weekday', 1) >= 0 && d.get(p + 'Weekday', 1) <= 6
        && d.get(p + 'Monthday', 1) is int && d.get(p + 'Monthday', 1) >= 1 && d.get(p + 'Monthday', 1) <= 28;
    }
    match /mailState/{id} {
      allow read, write: if false;
    }
    match /learningViews/{id} {
      allow read: if isOwner() || canEditArea('learning') || (isSignedIn() && resource.data.get('uid', '') == request.auth.uid);
      allow create, update: if isActive() && request.resource.data.get('uid', '') == request.auth.uid
        && id == request.resource.data.get('itemId', '') + '__' + request.auth.uid
        && request.resource.data.keys().hasOnly(['itemId', 'uid', 'name', 'email', 'firstAt', 'lastAt', 'count'])
        && request.resource.data.get('name', '') is string && request.resource.data.get('name', '').size() <= 120
        && request.resource.data.get('count', 0) is int;
    }
    match /clientErrors/{id} {
      allow read, delete: if isOwner();
      allow create: if isSignedIn() && request.resource.data.get('uid', '') == request.auth.uid
        && request.resource.data.keys().hasOnly(['message', 'stack', 'kind', 'view', 'version', 'url', 'ua', 'uid', 'email', 'at'])
        && request.resource.data.get('message', '') is string && request.resource.data.get('message', '').size() <= 500
        && request.resource.data.get('stack', '') is string && request.resource.data.get('stack', '').size() <= 2000
        && request.resource.data.get('ua', '') is string && request.resource.data.get('ua', '').size() <= 200
        && request.resource.data.get('url', '') is string && request.resource.data.get('url', '').size() <= 200;
    }
    // 2.45.0: the id is an FCM registration token's shape (letters, digits, '_', '-', ':';
    // 100–400 characters): made-up ids by the hundred made a notice's pushes fail for everyone.
    function fcmTokenOk(t) { return t.size() >= 100 && t.size() <= 400 && t.matches('[A-Za-z0-9_:-]+'); }
    match /pushTokens/{token} {
      allow read, delete: if isSignedIn() && (resource.data.get('uid', '') == request.auth.uid || isOwner());
      allow create, update: if isActive() && fcmTokenOk(token) && request.resource.data.get('uid', '') == request.auth.uid
        && request.resource.data.get('token', '') == token
        && request.resource.data.keys().hasOnly(['token', 'uid', 'ua', 'createdAt'])
        && request.resource.data.get('createdAt', 0) is number
        && request.resource.data.get('ua', '') is string && request.resource.data.get('ua', '').size() <= 200;
    }
    // 2.45.0: the "last sent" lines of the Notifications page — the owner, and License
    // Stock viewers not limited to one unit group (the log names the other group's
    // breakdowns). Daily Report and Damage viewers could read every mail sent.
    match /mailLog/{id} {
      allow read: if isOwner() || (canViewArea('licenseStock') && unitScope() == 'all');
      allow write: if false;
    }
    // 2.43.0: an 'own' requester sees the photos of its own requests only, and changes
    // only the request's own photos (<request>__p<n>, never a receipt's) while the
    // request is still its to change (draft, or just submitted) — like the request itself.
    function prPhotoOpen(id, orGone) {
      return id.split('__').size() == 2
          && (exists(prRecPath(recOfPhoto(id)))
              ? (mineIn(get(prRecPath(recOfPhoto(id))).data) && get(prRecPath(recOfPhoto(id))).data.get('status', '') in ['draft', 'submitted'])
              : orGone);
    }
    // 2.43.2: whatever the status, the requester may still finish a photo that was
    // waiting on its phone (pending: -> its upload in the photo's own folder), and
    // change nothing else — or a request approved meanwhile lost that photo for good.
    function prPhotoFinish(id) {
      return resource != null && id.split('__').size() == 2
          && resource.data.get('photo', '') is string && resource.data.get('photo', '').matches('pending:[a-z0-9]+')
          && request.resource.data.get('photo', '').matches('sp:photos/purchasePhotos/' + id + '/[A-Za-z0-9_-]+')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photo', 'updatedAt'])
          && recMine(prRecPath(recOfPhoto(id)), false);
    }
    match /purchasePhotos/{id} {
      allow read:   if canViewArea('purchase')
                    || (purchaseOwn() && (resource == null || recMine(prRecPath(recOfPhoto(id)), false)));
      allow delete: if canEditArea('purchase') || (purchaseOwn() && prPhotoOpen(id, true));
      allow create, update: if idMatches(id) && photoValOk('purchasePhotos', id)
                    && (canEditArea('purchase')
                        || (purchaseOwn() && photoOwnerKept(id) && (prPhotoOpen(id, false) || prPhotoFinish(id))));
    }
    // Device and stock photos (v185), one document per photo, up to ten per item.
    match /warehousePhotos/{id} { allow read: if canViewArea('warehouse'); allow delete: if canEditArea('warehouse');
                                  allow create, update: if canEditArea('warehouse') && idMatches(id)
                                    && request.resource.data.get('photo', '') is string
                                    && request.resource.data.get('photo', '').size() <= 400000; }

    // ---- Accounts ----
    // Sign-up may only ever create a PENDING VIEWER. Without this, any signed-in
    // user could write {role:'owner', status:'active'} to their own document and
    // take over the whole project. Role/access changes are owner-only.
    // The owner is pinned by Firebase Auth UID, which nobody can claim by
    // registering an address. (Pinned by e-mail, anyone could register the
    // owner's address the moment the original account was deleted or its
    // e-mail changed, and make themselves Super Admin.) Keep in sync with
    // OWNER_UIDS in firebase-init.js.
    function isOwnerAccount() {
      return isSignedIn() && request.auth.uid in ['vWZZ3jz1LTdzrU5c5Q1Gzco8nh72'];
    }
    function selfBootstrapsAsOwner() {
      return isOwnerAccount()
             && request.resource.data.role == 'owner'
             && request.resource.data.status == 'active';
    }

    // ---- Roles (v175) ----
    // Named sets of area levels the owner defines once and gives to people.
    // Saving a role writes its levels into each holder's own access map, so
    // every other rule keeps reading the user document only.
    match /roles/{id} {
      allow read, delete: if isOwner();
      allow create, update: if isOwner() && idMatches(id)
                   && request.resource.data.get('name', '') is string
                   && request.resource.data.get('name', '').size() > 0
                   && request.resource.data.get('name', '').size() <= 60
                   && request.resource.data.get('access', {}) is map;
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isOwner());

      // Own document only, and only as a pending viewer with no access map —
      // except the allowlisted owner, which bootstraps itself.
      allow create: if isSignedIn() && request.auth.uid == uid && (
                      (request.resource.data.role == 'viewer'
                       && request.resource.data.status == 'pending'
                       && !('access' in request.resource.data)
                       // A sign-up describes itself truthfully and briefly:
                       // its own uid and e-mail (so the owner approves the
                       // person they think they are approving), no extra
                       // fields, a short name.
                       && request.resource.data.get('uid', uid) == uid
                       && request.resource.data.get('email', '') == request.auth.token.email
                       && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'role',
                            'status', 'createdAt', 'updatedAt', 'updatedBy'])
                       && request.resource.data.get('displayName', '') is string
                       && request.resource.data.get('displayName', '').size() <= 80)
                      || selfBootstrapsAsOwner()
                    );

      // Owners manage everyone. The allowlisted owner may also repair its own
      // document (otherwise a demoted owner can never recover — isOwner() is
      // already false at that point).
      //
      // The third clause is what makes one-session-per-account possible: a
      // signed-in user may claim the session slot on their OWN document, and
      // affectedKeys().hasOnly() pins that to the single 'activeSession' field.
      // Role, status and access stay owner-only, so this opens no path to
      // self-promotion.
      // A stored unit group must be one the app knows — checked only when
      // the access map changes, so a role change or a remote sign-out still
      // works on a document that already holds a bad value.
      allow update: if (isOwner()
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['access'])
                            || request.resource.data.get('access', {}).get('unitScope', 'all') in ['all', 'tractor', 'heavy']))
                    || (request.auth.uid == uid && selfBootstrapsAsOwner())
                    || (request.auth.uid == uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['activeSession'])
                        // The session record is shown on the owner's Users
                        // page: a fixed, small shape. Checked on the RESULT,
                        // so a claim must replace the whole map — merged
                        // into, any stray key already stored would refuse
                        // this account's every sign-in from then on.
                        && request.resource.data.activeSession.keys().hasOnly(['id', 'startedAt', 'device'])
                        && request.resource.data.activeSession.get('id', '') is string
                        && request.resource.data.activeSession.get('id', '').size() <= 80
                        && request.resource.data.activeSession.get('device', '') is string
                        && request.resource.data.activeSession.get('device', '').size() <= 80);

      allow delete: if isOwner();
    }

    // ---- Audit log ----
    // Append-only: events can be created by any editor but never edited, and
    // the actor must be the signed-in user. Only owners may clear history.
    // A limited account reads its group's rows and the shared ones
    // (where('unitGroup', 'in', [<its group>, 'shared'])).
    match /history/{eventId} {
      allow read:   if canViewArea('history')
                    && (unitScope() == 'all' || resource.data.get('unitGroup', '') in [unitScope(), 'shared']);
      // Bound to the signed-in person: uid AND e-mail, the event's own id,
      // a known set of fields, and no timestamp far in the future (that
      // pinned forged rows above the real ones in the live feed).
      allow create: if canEditAnything()
                    && request.resource.data.actorUid == request.auth.uid
                    && request.resource.data.get('actorEmail', '') == request.auth.token.email
                    && request.resource.data.get('id', eventId) == eventId
                    && request.resource.data.timestamp is int
                    && request.resource.data.timestamp <= request.time.toMillis() + 86400000
                    && request.resource.data.keys().hasOnly(['id', 'timestamp', 'action', 'unitId',
                         'unitName', 'field', 'before', 'after', 'actorUid', 'actorEmail',
                         'actorName', 'actorRole', 'unitGroup'])
                    && request.resource.data.get('unitGroup', '') in ['', 'tractor', 'heavy', 'shared'];
      // Rows written before v167 carry no group, so a limited account cannot
      // read them: the owner may add the group once — that one field, only
      // while it is missing.
      allow update: if isOwner()
                    && !('unitGroup' in resource.data)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unitGroup'])
                    && request.resource.data.unitGroup in ['tractor', 'heavy', 'shared'];
      allow delete: if isOwner();
    }
  }
}
